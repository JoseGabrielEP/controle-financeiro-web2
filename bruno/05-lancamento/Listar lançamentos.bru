meta {
  name: Listar lançamentos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/lancamento
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("a lista contém o registro criado", function () {
    const ids = res.getBody().map(x => x.id);
    expect(ids).to.include(bru.getVar("lancamentoId"));
  });
}

docs {
  # GET /lancamento

  Lista todos os lançamentos.

  **Respostas**

  - `200` lista
}
