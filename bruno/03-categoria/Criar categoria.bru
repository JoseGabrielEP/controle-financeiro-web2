meta {
  name: Criar categoria
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/categoria
  body: json
  auth: none
}

body:json {
  {
    "nome": "Alimentação"
  }
}

assert {
  res.status: eq 200
  res.body.changes: eq 1
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("categoriaId", res.getBody().lastInsertRowid);
  }
}

tests {
  test("devolve o id criado", function () {
    expect(res.getBody().lastInsertRowid).to.be.a("number");
  });
}

docs {
  # POST /categoria

  Cria uma categoria. As categorias são compartilhadas entre todos os usuários.

  **Corpo** (todos obrigatórios)

  | Campo | Tipo |
  |---|---|
  | `nome` | string |

  **Respostas**

  - `200` `{ changes, lastInsertRowid }`
  - `400` corpo inválido (resumo do ArkType)
}
