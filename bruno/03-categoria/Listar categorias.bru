meta {
  name: Listar categorias
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/categoria
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("a lista contém o registro criado", function () {
    const ids = res.getBody().map(x => x.id);
    expect(ids).to.include(bru.getVar("categoriaId"));
  });
}

docs {
  # GET /categoria

  Lista todas as categorias.

  **Respostas**

  - `200` lista
}
