meta {
  name: Listar usuários
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/usuario
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("a lista contém o registro criado", function () {
    const ids = res.getBody().map(x => x.id);
    expect(ids).to.include(bru.getVar("usuarioId"));
  });
}

docs {
  # GET /usuario

  Lista todos os usuários.

  **Atenção:** a resposta inclui o campo `password_hash`.

  **Respostas**

  - `200` lista de usuários
}
