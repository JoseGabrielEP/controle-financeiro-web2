meta {
  name: Obter conta
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/conta/{{contaId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq {{contaId}}
}

docs {
  # GET /conta/:id

  Busca uma conta pelo id.

  **Respostas**

  - `200` a conta
  - `200` com `null` quando o id não existe (não responde 404)
}
